# Copy this file to .env and fill in real values once the backend/Cognito
# are deployed. Until then, the app runs entirely on dummy data and none
# of these are required.

# Base URL of the deployed API Gateway, e.g. https://xxxx.execute-api.ap-southeast-2.amazonaws.com
VITE_API_URL=

# Cognito User Pool ID and App Client ID (from the AWS Cognito console)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# AWS region the services are deployed in
VITE_REGION=ap-southeast-2
